# Virtual environments
venv/
.venv/

# Environment variables
.env
.env.*

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# pybaseball local cache
.pybaseball/

# IDE and tooling
.claude/
.vscode/
.idea/

# OS
.DS_Store

# Lahman data: only the CSVs the loader actually reads + the trimmed Chadwick
# bridge are committed. Other aux Lahman tables (Salaries, HallOfFame, etc.)
# and the raw Chadwick register stay local.
backend/data/lahman/*
!backend/data/lahman/Batting.csv
!backend/data/lahman/Pitching.csv
!backend/data/lahman/People.csv
!backend/data/lahman/chadwick_mlb.csv
!backend/data/lahman/Fielding.csv
!backend/data/lahman/AwardsPlayers.csv
!backend/data/lahman/AwardsSharePlayers.csv
!backend/data/lahman/AllstarFull.csv
!backend/data/lahman/BattingPost.csv
!backend/data/lahman/PitchingPost.csv
!backend/data/lahman/Teams.csv
!backend/data/lahman/HallOfFame.csv
!backend/data/lahman/SeriesPost.csv

# Retrosheet data: only the Chadwick retro bridge + the off-Railway-aggregated
# season/stint reference CSVs are committed. Raw daybyday dumps and scratch
# aggregation files stay local.
backend/data/retrosheet/*
!backend/data/retrosheet/chadwick_retro_bridge.csv
!backend/data/retrosheet/retro_names.csv
!backend/data/retrosheet/mlbam_names.csv
!backend/data/retrosheet/retrosheet_batting_seasons.csv
!backend/data/retrosheet/retrosheet_pitching_seasons.csv
!backend/data/retrosheet/retrosheet_batting_stints.csv
!backend/data/retrosheet/retrosheet_pitching_stints.csv

# Stray/empty local plays DB. The real play-by-play store is DuckDB, loaded onto
# the Railway volume at the absolute path /data/plays.duckdb (never committed, never
# under backend/). No code writes here — this is a local artifact only.
backend/data/plays.db

*.xcuserstate
